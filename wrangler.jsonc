{
  "name": "alpsconference-com",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-11",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpsconference-signups",
      "database_id": "0c956347-25be-4019-a0ed-2d8d6d4169ff",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
