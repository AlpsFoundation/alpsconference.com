---
import { withBase } from "../../lib/withBase";

/** One A4 page of the booklet: gradient wash, line-art layer, content, section word and folio. */
interface Props {
  id?: string;
  /** Page number printed in the corner and listed in the index. */
  number?: number;
  /** Section shown in the sticky header while this page is on screen. */
  section: string;
  /** Oversized word anchored to the foot of the page, as on the printed section openers. */
  word?: string;
  wordStyle?: "regular" | "light";
  /** Corner the pink wash rolls out of. */
  wash?: "tl" | "tr" | "bl" | "br";
  logo?: boolean;
  class?: string;
}

const {
  id,
  number,
  section,
  word,
  wordStyle = "regular",
  wash = "tl",
  logo = true,
  class: className,
} = Astro.props;
---

<section id={id} data-section={section} class:list={["bk-page", `bk-page--${wash}`, className]}>
  {Astro.slots.has("art") && (
    <div class="bk-art" aria-hidden="true">
      <slot name="art" />
    </div>
  )}
  {logo && <img class="bk-mark" src={withBase("img/booklet/alps-mark.png")} alt="" aria-hidden="true" />}
  <div class="bk-body">
    <slot />
    {word && <p class="bk-word" data-style={wordStyle} aria-hidden="true">{word}</p>}
  </div>
  {number != null && <p class="bk-folio" aria-hidden="true">{String(number).padStart(2, "0")}</p>}
</section>
