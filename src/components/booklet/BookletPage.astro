---
import { withBase } from "../../lib/withBase";

interface Props {
  id?: string;
  number?: string | number;
  /** Large word set at the foot of the page. */
  section?: string;
  sectionStyle?: "bold" | "light";
  /** Overrides the sticky title shown by the web chrome. */
  stickyTitle?: string;
  /** Corner the magenta wash rolls out of. */
  wash?: "tl" | "tr" | "bl" | "br" | "none";
  logo?: boolean;
  cover?: boolean;
  notes?: boolean;
  /** Tightens body type for pages carrying a long abstract. */
  dense?: boolean;
  /** Drops the tall footer reserve on pages with no section word. */
  tight?: boolean;
}

const {
  id,
  number,
  section,
  sectionStyle = "bold",
  stickyTitle,
  wash = "tl",
  logo = true,
  cover = false,
  notes = false,
  dense = false,
  tight = false,
} = Astro.props;

const pageNumber = number == null ? "" : String(number).padStart(2, "0");
const dataSection = stickyTitle ?? section;
const logoSrc = withBase("img/booklet/alps-mark.png");
---

<article
  id={id}
  data-section={dataSection}
  class:list={[
    "booklet-page",
    `booklet-page--wash-${wash}`,
    cover && "booklet-page--cover",
    notes && "booklet-page--notes",
    dense && "booklet-page--dense",
    (tight || !section) && "booklet-page--tight",
  ]}
>
  <div class="bk-deco-layer" aria-hidden="true">
    <slot name="deco" />
  </div>
  {logo && <img class="bk-logo" src={logoSrc} alt="ALPS" />}
  <div class="bk-body">
    <slot />
  </div>
  {section && <p class="bk-section" data-style={sectionStyle}>{section}</p>}
  {pageNumber && <p class="bk-number">{pageNumber}</p>}
</article>
