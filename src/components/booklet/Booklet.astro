---
import BookletPage from "./BookletPage.astro";
import Art from "./Art.astro";
import VenuePlan from "../VenuePlan";
import { PROGRAM, type ProgramItem } from "../../data/program";
import { WORKSHOP_DAY, WORKSHOP_TRACKS } from "../../data/workshops";
import { EXPERIENCE_DAYS } from "../../data/experiences";
import { EXPERIENCES } from "../../data/experienceProfiles";
import {
  getFaceCenter,
  getImageCrop,
  isConfirmedSpeaker,
  FRIDAY_PANEL_SPEAKERS,
  SATURDAY_PANEL_SPEAKERS,
  speakerByName,
  type Speaker,
} from "../../data/speakers";
import {
  ADVISORY_BOARDS,
  AFTERGLOW,
  ALUMNI,
  BOOKLET_NAV,
  CORE_PROGRAMS,
  CREDITS,
  FRIDAY_PANEL,
  INTRO_BRIDGES,
  INTRO_WELCOME,
  MEMBERSHIP,
  PALE_BLUE_DOT,
  PARTNER_GROUPS,
  PARTNERS_THANKS,
  PILLARS,
  POSTERS,
  PROJECTS,
  SATURDAY_PANEL,
  SPSN,
  SURVEY,
  SWITZERLAND,
  TEAM,
  VENUE,
  VENUE_MAP,
  WORKSHOP_INTRO,
  WORKSHOP_SUMMARIES,
  type BookletNavId,
  type TeamMember,
} from "../../data/bookletContent";
import { withBase } from "../../lib/withBase";

const img = (path: string) => withBase(`img/${path}`);

const DAY_STAMP: Record<string, string> = {
  Thursday: "Thu 08.10.26",
  Friday: "Fri 09.10.26",
  Saturday: "Sat 10.10.26",
};

/* ------------------------------------------------------------- talks -- */

type TalkEntry =
  | { kind: "talk"; key: string; speaker: Speaker; item: ProgramItem; day: string }
  | { kind: "panel"; key: string; panel: "friday" | "saturday"; item: ProgramItem; day: string };

/** Talks and panels in running order, read straight from the conference program. */
const talks: TalkEntry[] = PROGRAM.flatMap((day) =>
  day.items.flatMap((item): TalkEntry[] => {
    if (item.speakerName) {
      const speaker = speakerByName(item.speakerName);
      return speaker ? [{ kind: "talk", key: `talk-${speaker.name}`, speaker, item, day: day.day }] : [];
    }
    if (item.panel) return [{ kind: "panel", key: `panel-${item.panel}`, panel: item.panel, item, day: day.day }];
    return [];
  })
);

function avatarStyle(image?: string) {
  const crop = getImageCrop(image);
  return `--crop-pos:${crop.position};--crop-scale:${crop.scale};--crop-origin:${getFaceCenter(crop.faceBox)}`;
}

function paragraphs(text?: string) {
  return (text ?? "").split(/\n{2,}/).map((part) => part.trim()).filter(Boolean);
}

/** Short lines in an abstract ("Background", "Methods") are its section labels. */
function isLabel(paragraph: string) {
  return paragraph.length < 32 && !/[.:;!?]$/.test(paragraph);
}

function hasAbstract(abstract?: string) {
  return Boolean(abstract && abstract !== "TBD" && abstract !== "To be announced");
}

/* ------------------------------------------------------- experiences -- */

const startMinutes = (time: string) => {
  const [h, m] = time.split(/[–-]/)[0].trim().split(":").map(Number);
  return h * 60 + (m || 0);
};

/** Each day's sessions, one row per time slot ("11:00–12:00 & 14:30–15:30" becomes two rows). */
const experienceDays = EXPERIENCE_DAYS.map((day) => ({
  ...day,
  rows: day.items
    .filter((item) => item.kind !== "allday")
    .flatMap((item) => item.time.split("&").map((time) => ({ ...item, time: time.trim() })))
    .sort((a, b) => startMinutes(a.time) - startMinutes(b.time)),
}));
const allDayArt = EXPERIENCE_DAYS[0].items.find((item) => item.kind === "allday")?.credits ?? [];

function handleOf(instagram?: string) {
  if (!instagram) return undefined;
  const slug = instagram.replace(/^.*instagram\.com\//, "").replace(/\/$/, "");
  return slug ? `@${slug}` : undefined;
}

type Profile = {
  name: string;
  heading: string;
  photos: { src: string; position?: string }[];
  paragraphs: string[];
  sessions: { title: string; paragraphs: string[] }[];
  handle?: string;
  website?: string;
};

type ProfileSource = {
  name: string;
  role?: string;
  image?: string;
  imagePosition?: string;
  gallery?: string[];
  bio?: string;
  sessions?: { title: string; description: string }[];
  links?: { website?: string; instagram?: string };
};

function toProfile(person: ProfileSource, fallbackRole: string): Profile {
  const sessions = person.sessions ?? [];
  const single = sessions.length <= 1;
  const photos = [person.image, ...(person.gallery?.length === 1 ? person.gallery : [])]
    .filter((src): src is string => Boolean(src))
    .map((src, index) => ({ src, position: index === 0 ? person.imagePosition : undefined }));
  return {
    name: person.name,
    heading: single ? sessions[0]?.title ?? person.role ?? fallbackRole : person.role ?? fallbackRole,
    photos,
    paragraphs: [...paragraphs(person.bio), ...(single ? paragraphs(sessions[0]?.description) : [])],
    sessions: single ? [] : sessions.map((session) => ({ title: session.title, paragraphs: paragraphs(session.description) })),
    handle: handleOf(person.links?.instagram),
    website: person.links?.website,
  };
}

/** The booklet gives every artist and facilitator their own entry, two to a page. */
const experiencePages = EXPERIENCES.flatMap((category) => {
  const profiles = category.people.flatMap((person) =>
    person.artists?.length
      ? person.artists.map((artist) => toProfile(artist, person.role))
      : [toProfile(person, person.role)]
  );
  const pages: { label: string; profiles: Profile[]; first: boolean }[] = [];
  for (let i = 0; i < profiles.length; i += 2) {
    pages.push({ label: category.title, profiles: profiles.slice(i, i + 2), first: i === 0 });
  }
  return pages;
});

/* -------------------------------------------------------------- team -- */

const teamPages: { groups: { title: string; people: TeamMember[] }[]; heading: boolean }[] = [
  {
    heading: true,
    groups: [TEAM[0], { title: TEAM[1].title, people: TEAM[1].people.slice(0, 8) }],
  },
  { heading: false, groups: [{ title: TEAM[1].title, people: TEAM[1].people.slice(8) }] },
];

/* ------------------------------------------------------------ folios -- */

const PAGE_ORDER = [
  "cover",
  "index",
  "welcome",
  "bridges",
  "pillars",
  "programs",
  "spsn",
  "switzerland",
  "venue",
  "map",
  "workshops",
  ...PROGRAM.map((day) => `program-${day.day}`),
  "experiences",
  ...experiencePages.map((_, index) => `xp-${index}`),
  "afterglow",
  ...talks.map((entry) => entry.key),
  ...teamPages.map((_, index) => `team-${index}`),
  "boards",
  "partners",
  "credits",
  "projects",
  "research",
  "posters",
  "posters-grid",
  "membership",
  "donations",
  "conclusions",
];
const N = Object.fromEntries(PAGE_ORDER.map((key, index) => [key, index + 1])) as Record<string, number>;

const TOC_PAGE: Record<BookletNavId, number> = {
  introduction: N.welcome,
  "who-we-are": N.pillars,
  venue: N.venue,
  workshops: N.workshops,
  program: N[`program-${PROGRAM[0].day}`],
  experiences: N.experiences,
  talks: N[talks[0].key],
  team: N["team-0"],
  partners: N.partners,
  projects: N.projects,
  posters: N.posters,
  membership: N.membership,
  conclusions: N.conclusions,
};

const COVER_PARTNERS = [
  { file: "unibas.png", alt: "University of Basel" },
  { file: "unige.png", alt: "Université de Genève" },
  { file: "uzh.png", alt: "Universität Zürich" },
  { file: "unifr.png", alt: "Université de Fribourg" },
  { file: "hug.png", alt: "Hôpitaux Universitaires de Genève" },
];

const ARROW = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>`;
---

{/* ================================================================ cover */}
<BookletPage id="top" section="ALPS 2026" logo={false} class="bk-cover" wash="tl">
  <Art slot="art" src="mesh-synapse.webp" width={96} top={-18} left={-30} rotate={-8} opacity={0.62} />
  <div class="bk-cover__brand">
    <img class="bk-cover__logo" src={img("booklet/alps-wordmark.png")} alt="ALPS" />
    <p class="bk-cover__tagline">Awareness<br />Lectures on<br />Psychedelic<br />Science</p>
  </div>
  <h1 class="bk-cover__title">Conference<br />booklet</h1>
  <p class="bk-cover__meta">
    9–10 October 2026<br />
    Kultur &amp; Kongresshaus<br />
    Aarau, Switzerland
  </p>
  <div class="bk-cover__strip">
    {COVER_PARTNERS.map((partner) => <img src={img(`booklet/academic/${partner.file}`)} alt={partner.alt} />)}
  </div>
</BookletPage>

{/* ================================================================ index */}
<BookletPage id="index" number={N.index} section="Index" word="Index" wash="tl">
  <nav aria-label="Booklet contents">
    <ol class="bk-index">
      {BOOKLET_NAV.map((item) => (
        <li>
          <a href={`#${item.id}`}>
            <span class="bk-index__label">{item.label.toLowerCase()}</span>
            <span class="bk-index__leader" aria-hidden="true"></span>
            <span class="bk-index__page">{String(TOC_PAGE[item.id]).padStart(2, "0")}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</BookletPage>

{/* ========================================================= introduction */}
<BookletPage id="introduction" number={N.welcome} section="Introduction" word="Introduction" wash="tl">
  <h2 class="bk-title">{INTRO_WELCOME.title}</h2>
  <div class="bk-cols bk-copy">
    {INTRO_WELCOME.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="bk-signoff">{INTRO_WELCOME.signoff.map((line) => <>{line}<br /></>)}</p>
  </div>
</BookletPage>

<BookletPage number={N.bridges} section="Introduction" wash="tr">
  <Art slot="art" src="mesh-neuron.webp" width={125} top={74} left={-28} opacity={0.8} />
  <h2 class="bk-title">{INTRO_BRIDGES.title}</h2>
  <div class="bk-cols bk-copy">
    {INTRO_BRIDGES.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</BookletPage>

{/* =========================================================== who we are */}
<BookletPage id="who-we-are" number={N.pillars} section="Who we are" word="Who we are" wash="tl">
  <Art slot="art" src="neuron.svg" width={190} top={50} left={-100} opacity={0.5} />
  <h2 class="bk-title">{PILLARS.title}</h2>
  <div class="bk-cols bk-copy">
    {PILLARS.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</BookletPage>

<BookletPage number={N.programs} section="Who we are" wash="tr">
  <h2 class="bk-title">{CORE_PROGRAMS.title}</h2>
  {CORE_PROGRAMS.programs.map((program) => (
    <section class="bk-block">
      <h3 class="bk-subtitle">{program.title}</h3>
      <div class="bk-copy">
        {program.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </div>
      {program.link && (
        <p class="bk-actions">
          <a class="bk-btn" href={program.link.href} target="_blank" rel="noopener">{program.link.label}<Fragment set:html={ARROW} /></a>
        </p>
      )}
    </section>
  ))}
</BookletPage>

<BookletPage number={N.spsn} section="Who we are" wash="tl">
  <h2 class="bk-title">{SPSN.title}</h2>
  <figure class="bk-spsn" aria-label="Member associations of the Swiss Psychedelic Student Network">
    <img class="bk-spsn__hub" src={img(`booklet/spsn/${SPSN.hub.file}`)} alt={SPSN.hub.name} />
    <ul class="bk-spsn__ring">
      {SPSN.groups.map((group, index) => (
        <li style={`--a:${-90 + (index * 360) / SPSN.groups.length}deg`}>
          <img src={img(`booklet/spsn/${group.file}`)} alt="" loading="lazy" />
          <span>{group.name}</span>
        </li>
      ))}
    </ul>
  </figure>
  <div class="bk-cols bk-copy">
    {SPSN.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</BookletPage>

<BookletPage number={N.switzerland} section="Who we are" wash="tr">
  <h2 class="bk-title">{SWITZERLAND.title}</h2>
  <img class="bk-swiss" src={img("booklet/switzerland.svg")} alt="Outline of Switzerland" loading="lazy" />
  <p class="bk-lede">{SWITZERLAND.lead}</p>
  <div class="bk-cols bk-copy">
    {SWITZERLAND.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <figure class="bk-chart">
    <img src={img("booklet/pat-authorisations.png")} alt="Bar chart: Swiss authorisations for psychedelic-assisted therapy with MDMA, LSD and psilocybin, rising from a handful in 2016 to about 350 psilocybin authorisations in 2024" loading="lazy" />
    <figcaption>{SWITZERLAND.chartCaption}</figcaption>
  </figure>
</BookletPage>

{/* ================================================================ venue */}
<BookletPage id="venue" number={N.venue} section="Venue" word="Venue" wash="tl">
  <h2 class="bk-title">{VENUE.title},<br /><span class="bk-title__soft">{VENUE.address}</span></h2>
  <figure class="bk-photo bk-photo--wide">
    <img src={img("kuk-outside.jpg")} alt="The neoclassical facade of the Kultur & Kongresshaus Aarau on Schlossplatz" loading="lazy" />
  </figure>
  <div class="bk-copy">
    {VENUE.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p>{VENUE.practicalIntro}</p>
  </div>
  <ul class="bk-list bk-copy">
    {VENUE.practical.map((item) => <li><strong>{item.title}:</strong>{" "}{item.body}</li>)}
  </ul>
  <p class="bk-copy">{VENUE.signoff}</p>
</BookletPage>

<BookletPage number={N.map} section="Venue" wash="tr" class="bk-page--map">
  <h2 class="bk-title">{VENUE_MAP.title}</h2>
  <p class="bk-lede">{VENUE_MAP.intro}</p>
  <div class="bk-map">
    <VenuePlan client:visible size="embed" legend cooperative expandable />
  </div>
  <p class="bk-note">{VENUE_MAP.saal4}</p>
</BookletPage>

{/* ============================================================ workshops */}
<BookletPage id="workshops" number={N.workshops} section="Workshop program" wash="tl">
  <Art slot="art" src="neuron.svg" width={190} top={34} right={-92} rotate={-90} opacity={0.28} />
  <h2 class="bk-display">Workshop<br />program</h2>
  <p class="bk-stamp">{DAY_STAMP[WORKSHOP_DAY.day]} <span>· {WORKSHOP_DAY.time}</span></p>
  <h3 class="bk-kicker">{WORKSHOP_INTRO.heading}</h3>
  <p class="bk-lede">{WORKSHOP_INTRO.body}</p>
  <div class="bk-tracks">
    {WORKSHOP_TRACKS.map((track) => {
      const summary = WORKSHOP_SUMMARIES[track.language];
      const photos = track.sharedImage
        ? [{ src: track.sharedImage.src, alt: track.sharedImage.alt }]
        : track.speakers.filter((speaker) => speaker.image).map((speaker) => ({ src: speaker.image!, alt: speaker.name }));
      return (
        <article class="bk-track">
          <div class:list={["bk-track__photos", photos.length === 1 && "is-single"]}>
            {photos.map((photo) => <img src={img(`speakers/${photo.src}`)} alt={photo.alt} loading="lazy" />)}
          </div>
          <div>
            <p class="bk-eyebrow">{track.language} · {track.places} places</p>
            <h4 class="bk-track__title">“{summary?.title ?? track.title}”</h4>
            <p class="bk-copy">{summary?.summary ?? track.abstract[0]}</p>
          </div>
        </article>
      );
    })}
  </div>
</BookletPage>

{/* ============================================================== program */}
{PROGRAM.map((day, dayIndex) => (
  <BookletPage
    id={dayIndex === 0 ? "program" : undefined}
    number={N[`program-${day.day}`]}
    section="Program"
    wash={dayIndex === 0 ? "tr" : "tl"}
  >
    {dayIndex === 0 ? (
      <Art slot="art" src="neuron.svg" width={130} top={62} left={-72} rotate={-90} opacity={0.26} />
    ) : (
      <Art slot="art" src="mesh-synapse.webp" width={54} top={38} left={-25} rotate={-6} opacity={0.72} />
    )}
    <h2 class="bk-display">Program</h2>
    <p class="bk-stamp">{DAY_STAMP[day.day]}</p>
    <ol class="bk-schedule">
      {day.items.map((item) => (
        <li data-kind={item.kind ?? "session"}>
          <time>{item.time}</time>
          <div>
            <p class="bk-schedule__title">{item.title}</p>
            {item.detail && <p class="bk-schedule__detail">{item.detail}</p>}
          </div>
        </li>
      ))}
    </ol>
  </BookletPage>
))}

{/* ========================================================== experiences */}
<BookletPage id="experiences" number={N.experiences} section="Experiences" wash="tr">
  <Art slot="art" src="mesh-synapse.webp" width={74} top={-30} left={-44} flip opacity={0.55} />
  <h2 class="bk-display">Experiences</h2>
  {experienceDays.map((day, dayIndex) => (
    <section class="bk-xday">
      <p class="bk-stamp">{DAY_STAMP[day.day]}</p>
      <ol class="bk-schedule bk-schedule--xp">
        {day.rows.map((row) => (
          <li>
            <time>{row.time}</time>
            <div>
              <p class="bk-schedule__title">{row.personName ?? row.title}</p>
              {row.venue && <p class="bk-schedule__venue">{row.venue}</p>}
              <p class="bk-schedule__detail">{row.personName === row.title ? row.detail : row.title}</p>
            </div>
          </li>
        ))}
      </ol>
      {dayIndex === 0 && allDayArt.length > 0 && (
        <ul class="bk-allday">
          {allDayArt.map((credit) => (
            <li>
              <span class="bk-allday__when">Both days</span>
              <span class="bk-schedule__title">{credit.name}</span>
              <span class="bk-schedule__detail">{credit.type}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</BookletPage>

{experiencePages.map((page, pageIndex) => (
  <BookletPage number={N[`xp-${pageIndex}`]} section="Experiences" wash={pageIndex % 2 ? "tr" : "tl"}>
    <Art slot="art" src="sphere.svg" width={88} top={pageIndex % 2 ? 58 : 18} right={pageIndex % 2 ? undefined : -46} left={pageIndex % 2 ? -46 : undefined} opacity={0.1} />
    <p class="bk-rubric">
      <b>Experiences</b>
      <span>{page.label}</span>
    </p>
    {page.profiles.map((profile, index) => (
      <article class:list={["bk-profile", index % 2 === 1 && "bk-profile--flip"]}>
        <div class:list={["bk-profile__photos", profile.photos.length > 1 && "is-pair"]}>
          {profile.photos.map((photo) => (
            <img
              src={img(`experiences/${photo.src}`)}
              alt={profile.name}
              loading="lazy"
              style={photo.position ? `object-position:${photo.position}` : undefined}
            />
          ))}
        </div>
        <div class="bk-profile__text">
          <h3 class="bk-subtitle">{profile.heading}</h3>
          <p class="bk-profile__name">{profile.name}</p>
          <div class="bk-copy">
            {profile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {profile.sessions.map((session) => (
            <section class="bk-profile__session">
              <h4 class="bk-kicker">{session.title}</h4>
              <div class="bk-copy">{session.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
            </section>
          ))}
          {(profile.handle || profile.website) && (
            <p class="bk-profile__links">
              {profile.handle && <a href={`https://www.instagram.com/${profile.handle.slice(1)}/`} target="_blank" rel="noopener"><strong>{profile.handle}</strong></a>}
              {profile.website && <a href={profile.website} target="_blank" rel="noopener">{profile.website.replace(/^https?:\/\/(www\.)?/, "")}</a>}
            </p>
          )}
        </div>
      </article>
    ))}
  </BookletPage>
))}

<BookletPage number={N.afterglow} section="Experiences" wash="br">
  <p class="bk-rubric"><b>Experiences</b><span>…and more</span></p>
  <h2 class="bk-title">{AFTERGLOW.title}</h2>
  <figure class="bk-poster-frame">
    <img src={img("experiences/afterglow-banner.jpg")} alt="Afterglow poster: an SPSN afterparty for the ALPS Conference, 10.10.2026 from 21:30 till 04:00 at Aareal Flösserplatz, Aarau" loading="lazy" />
  </figure>
  <div class="bk-cols bk-cols--split">
    <div class="bk-copy">
      {AFTERGLOW.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
    </div>
    <div class="bk-copy">
      <p><strong>{AFTERGLOW.included}</strong></p>
      {AFTERGLOW.external.map((paragraph) => <p>{paragraph}</p>)}
      <div class="bk-cta">
        <a class="bk-btn" href={AFTERGLOW.ticketUrl} target="_blank" rel="noopener">{AFTERGLOW.ticketLabel}<Fragment set:html={ARROW} /></a>
        <img class="bk-qr" src={img("booklet/qr/afterglow.png")} alt="" loading="lazy" />
      </div>
    </div>
  </div>
</BookletPage>

{/* ======================================================== talks & panels */}
{talks.map((entry, index) => {
  if (entry.kind === "talk") {
    const { speaker, item, day } = entry;
    return (
      <BookletPage id={index === 0 ? "talks" : undefined} number={N[entry.key]} section="Talks & panels" wash={index % 2 ? "tr" : "tl"}>
        <Art slot="art" src="brain.svg" width={62} bottom={-10} right={-16} opacity={0.12} />
        <header class="bk-talk">
          <div class="bk-avatar" style={avatarStyle(speaker.image)}>
            {speaker.image && <img src={img(`speakers/${speaker.image}`)} alt={speaker.name} loading="lazy" />}
          </div>
          <div class="bk-talk__who">
            <p class="bk-eyebrow">{day} · {item.time}</p>
            <h2 class="bk-talk__name">{speaker.name}</h2>
            <p class="bk-talk__role">
              {speaker.role}
              {speaker.institution && <><br />{speaker.institution}</>}
            </p>
          </div>
        </header>
        {speaker.bio && <div class="bk-copy">{paragraphs(speaker.bio).map((paragraph) => <p>{paragraph}</p>)}</div>}
        {speaker.talkTitle && <h3 class="bk-talk__title">{speaker.talkTitle}</h3>}
        {hasAbstract(speaker.abstract) && (
          <div class="bk-copy">
            {paragraphs(speaker.abstract).map((paragraph) =>
              isLabel(paragraph) ? <p class="bk-copy__label">{paragraph}</p> : <p>{paragraph}</p>
            )}
          </div>
        )}
      </BookletPage>
    );
  }
  const friday = entry.panel === "friday";
  const copy = friday ? FRIDAY_PANEL : SATURDAY_PANEL;
  const people = (friday ? FRIDAY_PANEL_SPEAKERS : SATURDAY_PANEL_SPEAKERS).filter(isConfirmedSpeaker);
  // Panellists without a talk of their own (Ricardo Morales) get their full profile here.
  const guests = people.filter((person) => !talks.some((t) => t.kind === "talk" && t.speaker.name === person.name));
  return (
    <BookletPage number={N[entry.key]} section="Talks & panels" wash={friday ? "br" : "tr"}>
      <Art slot="art" src="mesh-neuron.webp" width={130} bottom={-22} right={-48} flip={!friday} opacity={0.5} />
      <p class="bk-eyebrow">Panel discussion · {entry.day} · {entry.item.time}</p>
      <h2 class="bk-title">{copy.title}</h2>
      {"subtitle" in copy && <p class="bk-lede bk-lede--italic">{copy.subtitle}</p>}
      <div class="bk-copy"><p>{copy.body}</p></div>
      <h3 class="bk-subtitle bk-panel__heading">Panel participants</h3>
      <ul class="bk-panel">
        {people.filter((person) => !guests.includes(person)).map((person) => (
          <li>
            <div class="bk-avatar" style={avatarStyle(person.image)}>
              {person.image && <img src={img(`speakers/${person.image}`)} alt="" loading="lazy" />}
            </div>
            <p>{person.name}</p>
          </li>
        ))}
      </ul>
      {guests.map((guest) => (
        <article class="bk-guest">
          <header class="bk-talk">
            <div class="bk-avatar" style={avatarStyle(guest.image)}>
              {guest.image && <img src={img(`speakers/${guest.image}`)} alt={guest.name} loading="lazy" />}
            </div>
            <div class="bk-talk__who">
              <h3 class="bk-talk__name">{guest.name}</h3>
              <p class="bk-talk__role">{guest.role}<br />{guest.institution}</p>
            </div>
          </header>
          <div class="bk-copy">{paragraphs(guest.bio).map((paragraph) => <p>{paragraph}</p>)}</div>
        </article>
      ))}
    </BookletPage>
  );
})}

