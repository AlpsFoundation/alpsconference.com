---
import BookletPage from "./BookletPage.astro";
import Deco from "./Deco.astro";
import { PROGRAM } from "../../data/program";
import { PARTNERS } from "../../data/partners";
import { WORKSHOP_DAY, WORKSHOP_TRACKS } from "../../data/workshops";
import { EXPERIENCE_DAYS } from "../../data/experiences";
import { EXPERIENCES } from "../../data/experienceProfiles";
import {
  getFaceCenter,
  getImageCrop,
  isConfirmedSpeaker,
  FRIDAY_PANEL_SPEAKERS,
  SATURDAY_PANEL_SPEAKERS,
  speakerByName,
} from "../../data/speakers";
import {
  BOOKLET_NAV,
  CORE_PROGRAMS,
  CREDITS,
  FRIDAY_PANEL,
  INTRO_BRIDGES,
  INTRO_WELCOME,
  MEMBERSHIP,
  PALE_BLUE_DOT,
  PILLARS,
  POSTERS,
  PRACTICAL_COPY,
  PROJECTS,
  SATURDAY_PANEL,
  SPSN_COPY,
  SPSN_GROUPS,
  SWITZERLAND_COPY,
  TEAM_SECTIONS,
  VENUE_COPY,
} from "../../data/bookletContent";
import { withBase } from "../../lib/withBase";

const confirmedTalks = PROGRAM.flatMap((day) =>
  day.items
    .filter((item) => item.speakerName)
    .map((item) => {
      const speaker = speakerByName(item.speakerName!);
      return speaker ? { speaker, item, day } : null;
    })
    .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
);

function handle(url?: string) {
  if (!url) return undefined;
  const slug = url.replace(/^.*instagram\.com\//, "").replace(/\/$/, "");
  return slug ? `@${slug}` : undefined;
}

/**
 * The booklet gives every artist and facilitator their own entry, so shared
 * cards (two painters on one site card) are flattened back into individuals.
 */
const experienceProfiles = EXPERIENCES.map((category) => ({
  category,
  people: category.people.flatMap((person) =>
    person.artists?.length
      ? person.artists.map((artist) => ({
          name: artist.name,
          role: artist.sessions?.[0]?.title ?? person.role,
          image: artist.image,
          imagePosition: artist.imagePosition,
          body: artist.sessions?.[0]?.description ?? artist.bio,
          handle: handle(artist.links?.instagram),
        }))
      : [
          {
            name: person.name,
            role: person.sessions?.[0]?.title ?? person.role,
            image: person.image ?? person.gallery?.[0],
            imagePosition: person.imagePosition,
            body: person.sessions?.[0]?.description ?? person.bio,
            handle: handle(person.links?.instagram),
          },
        ]
  ),
}));

/**
 * Experience profiles packed onto pages by estimated height, so a long profile
 * and two short ones can share a page without anything running past the trim.
 */
const XP_PAGE_MM = 236;
const XP_LABEL_MM = 14;

function experienceHeight(person: { body?: string }) {
  const lines = Math.ceil((person.body?.length ?? 0) / 92);
  return Math.max(50, 18 + lines * 3.9);
}

const experiencePages = experienceProfiles.flatMap(({ category, people }) => {
  const pages: { category: typeof category; people: typeof people; first: boolean }[] = [];
  let current: typeof people = [];
  let used = XP_LABEL_MM;
  for (const person of people) {
    const height = experienceHeight(person);
    if (current.length && used + height > XP_PAGE_MM) {
      pages.push({ category, people: current, first: pages.length === 0 });
      current = [];
      used = 0;
    }
    current.push(person);
    used += height;
  }
  if (current.length) pages.push({ category, people: current, first: pages.length === 0 });
  return pages;
});

const talkKeys = confirmedTalks.flatMap(({ speaker }) => [`talk-${speaker.name}`, `notes-${speaker.name}`]);

const PAGE_ORDER = [
  "index",
  "welcome",
  "bridges",
  "pillars",
  "programs",
  "spsn",
  "switzerland",
  "venue",
  "practical",
  "workshops",
  ...PROGRAM.map((day) => `program-${day.day.toLowerCase()}`),
  "experiences",
  ...experiencePages.map((_, index) => `experiences-${index}`),
  ...talkKeys,
  "panel-friday",
  "panel-saturday",
  "team",
  "partners",
  "projects",
  "posters",
  "posters-grid",
  "membership",
  "conclusions",
];

const PAGE = Object.fromEntries(PAGE_ORDER.map((key, index) => [key, index + 1])) as Record<string, number>;

const TOC_PAGES: Record<(typeof BOOKLET_NAV)[number]["id"], number> = {
  introduction: PAGE.welcome,
  "who-we-are": PAGE.pillars,
  venue: PAGE.venue,
  workshops: PAGE.workshops,
  program: PAGE["program-friday"],
  experiences: PAGE.experiences,
  talks: PAGE[talkKeys[0]],
  team: PAGE.team,
  partners: PAGE.partners,
  projects: PAGE.projects,
  posters: PAGE.posters,
  membership: PAGE.membership,
  conclusions: PAGE.conclusions,
};

const TOC = BOOKLET_NAV.map((item) => ({ ...item, page: TOC_PAGES[item.id] }));

const kukInside = withBase("img/kuk-inside.jpg");
const kukOutside = withBase("img/kuk-outside.jpg");
const logoSrc = withBase("img/booklet/alps-wordmark.png");
/** Colour marks for the white cover strip; the in-book pages use the white set. */
const COVER_PARTNERS = [
  { file: "unibas.png", alt: "University of Basel" },
  { file: "unige.png", alt: "Université de Genève" },
  { file: "uzh.png", alt: "Universität Zürich" },
  { file: "unifr.png", alt: "Université de Fribourg" },
  { file: "hug.png", alt: "Hôpitaux Universitaires de Genève" },
];

function cropStyle(image?: string) {
  const crop = getImageCrop(image);
  return `--crop-pos:${crop.position};--crop-scale:${crop.scale};--crop-origin:${getFaceCenter(crop.faceBox)}`;
}

/** Long abstracts get a slightly tighter type size so the page still holds. */
function isDense(speaker: { abstract?: string; bio?: string }) {
  return (speaker.abstract?.length ?? 0) + (speaker.bio?.length ?? 0) > 2200;
}

function hasAbstract(abstract?: string) {
  return Boolean(abstract && abstract !== "TBD" && abstract !== "To be announced");
}

function roleLine(speaker: { role?: string; institution?: string }) {
  return [speaker.role, speaker.institution].filter(Boolean);
}

const dayStamp: Record<string, string> = {
  Thursday: "THU 08.10.26",
  Friday: "FRI 09.10.26",
  Saturday: "SAT 10.10.26",
};
---

{/* ------------------------------------------------------------------ cover */}
<BookletPage id="cover" cover wash="tl" logo={false} stickyTitle="ALPS 2026">
  <Deco slot="deco" src="synapse.svg" w="300mm" top="-52mm" left="-118mm" opacity={0.3} />
  <div class="bk-cover">
    <div class="bk-cover__brand">
      <img class="bk-cover__logo" src={logoSrc} alt="ALPS" />
      <p class="bk-cover__tagline">Awareness<br />Lectures on<br />Psychedelic<br />Science</p>
    </div>
    <h1 class="bk-cover__title">Conference<br />booklet</h1>
    <p class="bk-cover__meta">
      9–10 October 2026<br />
      Kultur &amp; Kongresshaus<br />
      Aarau, Switzerland
    </p>
  </div>
  <div class="bk-cover__strip">
    {COVER_PARTNERS.map((partner) => (
      <img src={withBase(`img/booklet/academic/${partner.file}`)} alt={partner.alt} />
    ))}
  </div>
</BookletPage>

{/* ------------------------------------------------------------------ index */}
<BookletPage id="index" number={PAGE.index} section="Index" wash="tl">
  <Deco slot="deco" src="sphere.svg" w="150mm" top="-30mm" right="-50mm" opacity={0.15} />
  <Deco slot="deco" src="sphere.svg" w="95mm" bottom="18mm" left="-28mm" opacity={0.13} />
  <ol class="bk-index">
    {TOC.map((item) => (
      <li>
        <a href={`#${item.id}`}>
          <span>{item.printLabel}</span>
          <span class="bk-index__leader"></span>
          <span class="bk-index__page">{String(item.page).padStart(2, "0")}</span>
        </a>
      </li>
    ))}
  </ol>
</BookletPage>

{/* ----------------------------------------------------------- introduction */}
<BookletPage id="introduction" number={PAGE.welcome} section="Introduction" wash="tl">
  <Deco slot="deco" src="sphere.svg" w="120mm" bottom="30mm" left="-34mm" opacity={0.16} />
  <h1 class="bk-h1">{INTRO_WELCOME.title}</h1>
  <div class="bk-cols bk-copy">
    {INTRO_WELCOME.columns.map((column) => (
      <div>{column.map((paragraph) => <p>{paragraph}</p>)}</div>
    ))}
  </div>
</BookletPage>

<BookletPage number={PAGE.bridges} stickyTitle="Introduction" wash="tr" tight>
  <Deco slot="deco" src="sphere.svg" w="110mm" bottom="-30mm" right="-30mm" opacity={0.12} />
  <h1 class="bk-h1">{INTRO_BRIDGES.title}</h1>
  <div class="bk-cols bk-copy">
    {INTRO_BRIDGES.columns.map((column) => (
      <div>{column.map((paragraph) => <p>{paragraph}</p>)}</div>
    ))}
  </div>
</BookletPage>

{/* ------------------------------------------------------------- who we are */}
<BookletPage id="who-we-are" number={PAGE.pillars} section="Who we are" wash="bl">
  <Deco slot="deco" src="sphere.svg" w="135mm" top="14mm" right="-45mm" opacity={0.14} />
  <h1 class="bk-h1">{PILLARS.title}</h1>
  <div class="bk-cols bk-copy">
    {PILLARS.columns.map((column) => (
      <div>{column.map((paragraph) => <p>{paragraph}</p>)}</div>
    ))}
  </div>
</BookletPage>

<BookletPage number={PAGE.programs} stickyTitle="Who we are" wash="tr" tight>
  <Deco slot="deco" src="brain.svg" w="130mm" bottom="-32mm" left="-40mm" opacity={0.1} />
  <h1 class="bk-h1">Our three core programs</h1>
  <div class="bk-copy">
    {CORE_PROGRAMS.map((program) => (
      <>
        <h2 class="bk-h2">{program.title}</h2>
        <p>{program.body}</p>
      </>
    ))}
  </div>
</BookletPage>

<BookletPage number={PAGE.spsn} stickyTitle="Who we are" wash="tl" tight>
  <Deco slot="deco" src="sphere.svg" w="115mm" bottom="-26mm" left="-32mm" opacity={0.15} />
  <h1 class="bk-h1">The Swiss Psychedelic Student Network (SPSN)</h1>
  <div class="bk-spsn">
    {SPSN_GROUPS.map((group) => (
      <img src={withBase(`img/booklet/spsn/${group.file}`)} alt={`${group.name} — ${group.city}`} />
    ))}
  </div>
  <div class="bk-cols bk-copy">
    <div>{SPSN_COPY.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}</div>
    <div>{SPSN_COPY.slice(2).map((paragraph) => <p>{paragraph}</p>)}</div>
  </div>
</BookletPage>

<BookletPage number={PAGE.switzerland} stickyTitle="Who we are" wash="tr" tight>
  <h1 class="bk-h1">Switzerland: a unique landscape for psychedelic science</h1>
  <img
    src={withBase("img/booklet/switzerland.svg")}
    alt="Outline of Switzerland"
    style="width: 110mm; margin: 4mm auto 8mm;"
  />
  <p class="bk-lede">{SWITZERLAND_COPY.lead}</p>
  <div class="bk-cols bk-copy">
    {SWITZERLAND_COPY.columns.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <div class="bk-push" style="width: 100mm; margin-left: auto;">
    <figure class="bk-figure">
      <img src={withBase("img/booklet/pat-authorisations.png")} alt="Swiss PAT authorisations delivered since 2016" />
    </figure>
    <p class="bk-caption">Liechti, 2025: Swiss authorisations delivered for PAT since 2016.</p>
  </div>
</BookletPage>

{/* ------------------------------------------------------------------ venue */}
<BookletPage id="venue" number={PAGE.venue} section="Venue" wash="tl">
  <Deco slot="deco" src="sphere.svg" w="110mm" bottom="34mm" left="-30mm" opacity={0.14} />
  <h1 class="bk-h1">{VENUE_COPY.title}</h1>
  <div class="bk-cols" style="margin-bottom: 6mm;">
    <div class="bk-photo bk-photo--venue"><img src={kukOutside} alt="Exterior of Kultur & Kongresshaus Aarau" /></div>
    <div class="bk-photo bk-photo--venue"><img src={kukInside} alt="Interior of Kultur & Kongresshaus Aarau" /></div>
  </div>
  <div class="bk-copy">
    {VENUE_COPY.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</BookletPage>

<BookletPage number={PAGE.practical} stickyTitle="Venue" wash="tr" tight>
  <Deco slot="deco" src="sphere.svg" w="100mm" top="-24mm" right="-28mm" opacity={0.12} />
  <h1 class="bk-h1">Practical information</h1>
  <ul class="bk-bullets">
    {PRACTICAL_COPY.map((item) => (
      <li><strong>{item.title}.</strong>{" "}{item.body}</li>
    ))}
  </ul>
  <div style="margin-top: 4mm;">
    <div class="bk-facts">
      {VENUE_COPY.facts.map((fact) => (
        <div>
          <strong>{fact.label}</strong>
          <p>{fact.value}</p>
        </div>
      ))}
    </div>
  </div>
</BookletPage>

{/* -------------------------------------------------------- workshop day -- */}
<BookletPage id="workshops" number={PAGE.workshops} wash="tl" tight>
  <Deco slot="deco" src="neuron.svg" w="230mm" top="-10mm" right="-90mm" opacity={0.14} />
  <p class="bk-pagetitle">Workshop<br />program</p>
  <p class="bk-day">{dayStamp[WORKSHOP_DAY.day]}</p>
  <h2 class="bk-h2">One afternoon, four parallel tracks</h2>
  <p class="bk-lede">
    Four parallel clinical training tracks reflecting Switzerland’s multilingual landscape, {WORKSHOP_DAY.time}. No
    prior experience required.
  </p>
  <div class="bk-copy">
    {WORKSHOP_TRACKS.map((track) => (
      <div class="bk-track">
        <p class="bk-track__head">
          <span class="bk-flag">{track.flag}</span>{track.language} — “{track.title}”
        </p>
        <p class="bk-track__people">Facilitators: {track.presenters} · {track.places} places</p>
        {track.cancelledNote && <p class="bk-track__cancelled">{track.cancelledNote}</p>}
        <p>{track.abstract[0]}</p>
      </div>
    ))}
  </div>
</BookletPage>

{/* ---------------------------------------------------------------- program */}
{PROGRAM.map((day, dayIndex) => (
  <BookletPage
    id={dayIndex === 0 ? "program" : undefined}
    number={PAGE[`program-${day.day.toLowerCase()}`]}
    stickyTitle="Program"
    wash={dayIndex === 0 ? "tl" : "tr"}
    tight
  >
    <Deco
      slot="deco"
      src={dayIndex === 0 ? "neuron.svg" : "sphere.svg"}
      w={dayIndex === 0 ? "240mm" : "140mm"}
      top={dayIndex === 0 ? "10mm" : "40mm"}
      left={dayIndex === 0 ? "-120mm" : "-40mm"}
      opacity={0.13}
    />
    <p class="bk-pagetitle">Program</p>
    <p class="bk-day">{dayStamp[day.day]}</p>
    <ol class="bk-schedule">
      {day.items.map((item) => (
        <li data-kind={item.kind ?? "session"}>
          <time>{item.time}</time>
          <div>
            <p class="bk-schedule__title">{item.title}</p>
            {item.detail && <em class="bk-schedule__detail">{item.detail}</em>}
          </div>
        </li>
      ))}
    </ol>
  </BookletPage>
))}

{/* ------------------------------------------------------------ experiences */}
<BookletPage id="experiences" number={PAGE.experiences} wash="tr" tight>
  <Deco slot="deco" src="sphere.svg" w="130mm" bottom="-34mm" left="-38mm" opacity={0.13} />
  <p class="bk-pagetitle" style="margin-bottom: 8mm;">Experiences</p>
  <div class="bk-cols">
    {EXPERIENCE_DAYS.map((day) => (
      <div>
        <p class="bk-day" style="font-size: 17pt; margin-bottom: 5mm;">{dayStamp[day.day]}</p>
        <ol class="bk-schedule">
          {day.items.map((item) => (
            <li>
              <time>{item.kind === "allday" ? "both days" : item.time}</time>
              <div>
                <p class="bk-schedule__title">
                  {item.credits ? item.credits.map((credit) => credit.name).join(", ") : item.personName ?? item.title}
                </p>
                <em class="bk-schedule__detail">
                  {item.credits ? item.title : item.title}
                  {item.venue ? ` · ${item.venue}` : ""}
                </em>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</BookletPage>

{experiencePages.map((page, pageIndex) => (
  <BookletPage number={PAGE[`experiences-${pageIndex}`]} stickyTitle="Experiences" wash={pageIndex % 2 ? "tr" : "tl"} tight>
    <Deco slot="deco" src="sphere.svg" w="120mm" top="-24mm" right="-34mm" opacity={0.12} />
    {page.first && <p class="bk-eyebrow" style="font-size: 17pt; margin-bottom: 6mm;">{page.category.title}</p>}
    {page.people.map((person, personIndex) => (
      <article class:list={["bk-xp", personIndex % 2 === 1 && "bk-xp--flip"]}>
        <div class="bk-xp__figure">
          {person.image && (
            <img
              src={withBase(`img/experiences/${person.image}`)}
              alt={person.name}
              style={person.imagePosition ? `object-position:${person.imagePosition}` : undefined}
            />
          )}
        </div>
        <div>
          <h2 class="bk-xp__name">{person.name}</h2>
          <p class="bk-xp__kind">{person.role}</p>
          {person.body && <div class="bk-copy"><p>{person.body}</p></div>}
          {person.handle && <p class="bk-xp__handle">{person.handle}</p>}
        </div>
      </article>
    ))}
  </BookletPage>
))}

{/* ------------------------------------------------------------------ talks */}
{confirmedTalks.map(({ speaker, item, day }, talkIndex) => (
  <>
    <BookletPage
      id={talkIndex === 0 ? "talks" : undefined}
      number={PAGE[`talk-${speaker.name}`]}
      stickyTitle="Talks & panels"
      wash={talkIndex % 2 ? "tr" : "tl"}
      dense={isDense(speaker)}
      tight
    >
      <Deco slot="deco" src="sphere.svg" w="105mm" top="-18mm" right="-26mm" opacity={0.13} />
      <Deco slot="deco" src="brain.svg" w="95mm" bottom="-18mm" right="-14mm" opacity={0.08} />
      <header class="bk-talk__head">
        <div class="bk-avatar" style={cropStyle(speaker.image)}>
          {speaker.image && <img src={withBase(`img/speakers/${speaker.image}`)} alt={speaker.name} />}
        </div>
        <div>
          <h1 class="bk-talk__name">{speaker.name}</h1>
          <p class="bk-talk__role">
            {roleLine(speaker).map((line) => <>{line}<br /></>)}
            {day.day} · {item.time}
          </p>
        </div>
      </header>
      {speaker.bio && <div class="bk-copy"><p>{speaker.bio}</p></div>}
      {speaker.talkTitle && <h2 class="bk-talk__title">{speaker.talkTitle}</h2>}
      {hasAbstract(speaker.abstract) && (
        <div class="bk-copy">
          {speaker.abstract!.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}
    </BookletPage>

    <BookletPage
      number={PAGE[`notes-${speaker.name}`]}
      stickyTitle="Talks & panels"
      notes
      wash={talkIndex % 2 ? "tl" : "tr"}
      tight
    >
      <Deco slot="deco" src="mushroom-pair.png" w="105mm" bottom="-14mm" right="-10mm" opacity={0.5} />
      <div class="bk-notes">
        <p class="bk-notes__label">Notes</p>
        <div class="bk-notes__sheet"></div>
      </div>
    </BookletPage>
  </>
))}

{/* ----------------------------------------------------------------- panels */}
<BookletPage number={PAGE["panel-friday"]} stickyTitle="Talks & panels" wash="tl" tight>
  <Deco slot="deco" src="neurons.svg" w="150mm" bottom="-40mm" left="-46mm" opacity={0.12} />
  <p class="bk-eyebrow">Friday · 18:15–19:15</p>
  <h1 class="bk-h1">{FRIDAY_PANEL.title}</h1>
  <p class="bk-lede" style="font-style: italic;">{FRIDAY_PANEL.subtitle}</p>
  <div class="bk-copy"><p>{FRIDAY_PANEL.body}</p></div>
  <div class="bk-push">
    <h2 class="bk-h2">Panel participants</h2>
    <div class="bk-cols">
      {FRIDAY_PANEL_SPEAKERS.filter(isConfirmedSpeaker).map((person) => (
        <div class="bk-xp" style="margin-bottom: 4mm; grid-template-columns: 24mm minmax(0, 1fr); gap: 4mm;">
          <div class="bk-xp__figure" style="width: 24mm; height: 24mm;">
            {person.image && <img src={withBase(`img/speakers/${person.image}`)} alt={person.name} />}
          </div>
          <div>
            <h3 class="bk-h3">{person.name}</h3>
            <p class="bk-xp__kind">{person.institution}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</BookletPage>

<BookletPage number={PAGE["panel-saturday"]} stickyTitle="Talks & panels" wash="tr" tight>
  <Deco slot="deco" src="neurons.svg" w="150mm" bottom="-40mm" right="-46mm" opacity={0.12} flip />
  <p class="bk-eyebrow">Saturday · 18:00–19:00</p>
  <h1 class="bk-h1">{SATURDAY_PANEL.title}</h1>
  <div class="bk-copy"><p>{SATURDAY_PANEL.body}</p></div>
  <div class="bk-push">
    <h2 class="bk-h2">Panel participants</h2>
    <div class="bk-cols">
      {SATURDAY_PANEL_SPEAKERS.filter(isConfirmedSpeaker).map((person) => (
        <div class="bk-xp" style="margin-bottom: 4mm; grid-template-columns: 24mm minmax(0, 1fr); gap: 4mm;">
          <div class="bk-xp__figure" style="width: 24mm; height: 24mm;">
            {person.image && <img src={withBase(`img/speakers/${person.image}`)} alt={person.name} />}
          </div>
          <div>
            <h3 class="bk-h3">{person.name}</h3>
            <p class="bk-xp__kind">{person.institution}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</BookletPage>

{/* ------------------------------------------------------------------- team */}
<BookletPage id="team" number={PAGE.team} wash="bl" tight>
  <Deco slot="deco" src="sphere-pink.svg" w="130mm" bottom="-36mm" right="-40mm" opacity={0.2} />
  <h1 class="bk-h1" style="font-size: 26pt; margin-bottom: 8mm;">Meet the team</h1>
  {TEAM_SECTIONS.map((section) => (
    <div class="bk-team-group">
      <h2><b>ALPS</b>{" "}{section.title}</h2>
      <div class="bk-team">
        {section.people.map((person) => (
          <p>
            {person.name}
            <span>{person.role}</span>
          </p>
        ))}
      </div>
    </div>
  ))}
</BookletPage>

{/* --------------------------------------------------------------- partners */}
<BookletPage id="partners" number={PAGE.partners} section="Partners" sectionStyle="light" wash="br">
  <Deco slot="deco" src="sphere-pink.svg" w="120mm" bottom="10mm" right="-34mm" opacity={0.18} />
  {Object.entries(PARTNERS).map(([category, logos]) => (
    <div class="bk-partner-group">
      <h3>{category}</h3>
      <div class="bk-partner-row">
        {logos.map((partner) => (
          <img src={withBase(partner.src.replace("/img/partners/", "img/booklet/partners/"))} alt={partner.alt} />
        ))}
      </div>
    </div>
  ))}
  <div class="bk-push">
    <h2 class="bk-h2">Postgraduate training credits</h2>
    <div class="bk-copy">
      <p>{CREDITS.fsp}</p>
      <p>{CREDITS.sgpp}</p>
      <p>{CREDITS.note}</p>
    </div>
  </div>
</BookletPage>

