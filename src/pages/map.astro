---
import "../styles/app.css";
import planRaw from "../assets/venue-plan.svg?raw";
import { withBase } from "../lib/withBase";

const switzerFont = withBase("fonts/Switzer-Variable.woff2");
const fontFaceCss = `@font-face {
  font-family: "Switzer";
  src: url("${switzerFont}") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}`;

// The designer's export carries its own legend as magenta <text> glyphs; drop
// them (the legend is rebuilt in HTML below) and keep only the drawing layers.
const planInner = planRaw
  .replace(/^[\s\S]*?<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replace(/<defs\s*\/>/, "")
  .replace(/<text\b[^>]*>[\s\S]*?<\/text>/g, "");

// Crop of the export's 1190×842 artboard that holds the floor plan.
const VIEW = { x: 84, y: 134, w: 1052, h: 432 };

type Section = {
  id: string;
  title: string;
  tagline: string;
  color: string;
  notes?: string[];
  items: { n?: number; label: string }[];
};

const sections: Section[] = [
  {
    id: "alps",
    title: "ALPS",
    tagline: "Branding throughout",
    color: "#ff5cc8",
    items: [
      { n: 1, label: "Reception" },
      { n: 2, label: "Merchandising" },
      { n: 3, label: "ALPS Visuals" },
      { n: 4, label: "Main stage" },
      { n: 5, label: "ALPS Posters" },
      { n: 6, label: "Stage" },
    ],
  },
  {
    id: "lounges",
    title: "Lounges",
    tagline: "Aarau furniture",
    color: "#c98bff",
    notes: ["Illuminated Japanese walls", "ALPS posters"],
    items: [{ n: 7, label: "3 × Lounges" }],
  },
  {
    id: "catering",
    title: "Catering",
    tagline: "Central space",
    color: "#b3c2ff",
    items: [{ n: 8, label: "Catering and food installation" }],
  },
  {
    id: "exhibitors",
    title: "Exhibitors",
    tagline: "Well surrounded",
    color: "#ffb938",
    items: [
      { n: 9, label: "Exhibitor stand" },
      { n: 10, label: "Exhibitor stand" },
      { n: 11, label: "Exhibitor stand" },
    ],
  },
  {
    id: "posters",
    title: "Research Posters",
    tagline: "A complete overview",
    color: "#f3e25a",
    items: [{ n: 12, label: "15 × Research posters" }],
  },
  {
    id: "kevin",
    title: "Kevin Barron Exhibition",
    tagline: "A dedicated space",
    color: "#5fd37a",
    items: [{ n: 13, label: "14 × A0 display area + 1 table" }],
  },
  {
    id: "hannah",
    title: "Hannah Stanke Artwork",
    tagline: "Close to people",
    color: "#9bf28f",
    items: [{ n: 14, label: "2 × A0 display area" }],
  },
  {
    id: "meditation",
    title: "Meditation Room",
    tagline: "LED candle lights",
    color: "#ff6b6b",
    items: [],
  },
];

// Centres of the numbers in the source drawing (user units).
const markers: { n: number; x: number; y: number }[] = [
  { n: 1, x: 522, y: 469 },
  { n: 2, x: 505, y: 326 },
  { n: 3, x: 651, y: 393 },
  { n: 4, x: 992, y: 385 },
  { n: 5, x: 178, y: 246 },
  { n: 6, x: 236, y: 248 },
  { n: 7, x: 465, y: 203 },
  { n: 7, x: 320, y: 326 },
  { n: 7, x: 344, y: 450 },
  { n: 8, x: 419, y: 385 },
  { n: 9, x: 240, y: 314 },
  { n: 10, x: 175, y: 294 },
  { n: 11, x: 176, y: 325 },
  { n: 12, x: 159, y: 449 },
  { n: 13, x: 594, y: 390 },
  { n: 14, x: 310, y: 439 },
];

const sectionOf = new Map<number, Section>();
const labelOf = new Map<number, string>();
for (const s of sections) for (const i of s.items) if (i.n) {
  sectionOf.set(i.n, s);
  labelOf.set(i.n, i.label);
}

const palettes = {
  blueprint: { label: "Blueprint", paper: "#0e4a78", ink: "#ffffff", wall: "#2a6a9f", furniture: "#ffffff", detail: "#86aed3", display: "#f38fbf", grid: "#1a5889", marker: "#ffffff", hot: "#ff4fa3" },
  white: { label: "White", paper: "#ffffff", ink: "#1b4f8a", wall: "#d9e6f4", furniture: "#2f7fc1", detail: "#a9c2de", display: "#e0336b", grid: "#e4edf7", marker: "#123e67", hot: "#ff2d95" },
  navy: { paper: "#ffffff", label: "ALPS Navy", ink: "#123e67", wall: "#e2e8ee", furniture: "#3d6a93", detail: "#b7c6d4", display: "#123e67", grid: "#eef2f6", marker: "#123e67", hot: "#ff2d95" },
  graphite: { paper: "#ffffff", label: "Graphite", ink: "#2a2d31", wall: "#e9eaec", furniture: "#6c737c", detail: "#c4c8cd", display: "#d9480f", grid: "#f0f1f2", marker: "#2a2d31", hot: "#ff2d95" },
  terracotta: { paper: "#ffffff", label: "Terracotta", ink: "#5b3b2a", wall: "#f1e6da", furniture: "#b8653b", detail: "#d9c3ae", display: "#2f6f8f", grid: "#f5eee6", marker: "#5b3b2a", hot: "#ff2d95" },
  original: { paper: "#ffffff", label: "Original", ink: "#000000", wall: "#000000", furniture: "#1e78a9", detail: "#bebebe", display: "#ff0000", grid: "#f2f2f2", marker: "#ff00ff", hot: "#ff2d95" },
};

const colorKnobs = [
  ["paper", "Paper"],
  ["ink", "Ink"],
  ["wall", "Walls"],
  ["furniture", "Furniture"],
  ["detail", "Details"],
  ["display", "Displays"],
  ["grid", "Grid"],
  ["marker", "Markers"],
  ["hot", "Highlight"],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Working layout plan: not linked, not in the sitemap. -->
    <meta name="robots" content="noindex" />
    <title>Venue map | ALPS Conference 2026</title>
    <meta name="description" content="Layout plan of the Kultur & Kongresshaus Aarau for ALPS Conference 2026." />
    <meta name="theme-color" content="#0B3C5D" />
    <link rel="preload" href={switzerFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={withBase("img/favicon.png")} />
    <style is:global set:html={fontFaceCss}></style>
  </head>
  <body class="vm" data-walls="hatched" data-grid="on" data-markers="uniform">
    <header class="vm-head">
      <div>
        <p class="section-eyebrow">ALPS Conference 2026 · 9–10 October</p>
        <h1 class="section-title">Venue map</h1>
        <p class="vm-sub">Kultur &amp; Kongresshaus Aarau: layout plan</p>
      </div>
      <p class="vm-hint">Scroll or pinch to zoom · drag to pan · click a number</p>
    </header>

    <main>
      <section class="vm-stage" aria-label="Floor plan">
        <svg
          id="vm-svg"
          class="vm-svg"
          viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`}
          data-base={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`}
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Floor plan of the conference venue with numbered areas"
        >
          <defs>
            <pattern id="vm-grid-minor" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M10 0H0V10" class="vm-grid-line" />
            </pattern>
            <pattern id="vm-grid" width="50" height="50" patternUnits="userSpaceOnUse">
              <rect width="50" height="50" fill="url(#vm-grid-minor)" />
              <path d="M50 0H0V50" class="vm-grid-line vm-grid-major" />
            </pattern>
            <pattern id="vm-hatch" width="3.2" height="3.2" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <rect width="3.2" height="3.2" class="vm-hatch-bg" />
              <path d="M0 0V3.2" class="vm-hatch-line" />
            </pattern>
          </defs>
          <rect class="vm-grid-rect" x="-2000" y="-2000" width="5200" height="4800" fill="url(#vm-grid)" />
          <g class="vm-plan" set:html={planInner} />
          <g class="vm-markers">
            {markers.map((m) => {
              const s = sectionOf.get(m.n)!;
              return (
                <g
                  class="vm-marker"
                  data-n={m.n}
                  data-section={s.id}
                  transform={`translate(${m.x} ${m.y})`}
                  style={`--sec: ${s.color}`}
                  tabindex="0"
                  role="button"
                  aria-label={`${m.n}: ${labelOf.get(m.n)} (${s.title})`}
                >
                  <g class="vm-marker-scale">
                    <circle class="vm-marker-halo" r="15" />
                    <circle class="vm-marker-dot" r="10.5" />
                    <text class="vm-marker-num" text-anchor="middle" dy="0.36em">{m.n}</text>
                  </g>
                </g>
              );
            })}
          </g>
        </svg>

        <div class="vm-tip" id="vm-tip" hidden></div>

        <div class="vm-zoom" role="group" aria-label="Zoom">
          <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
          <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
          <button type="button" data-zoom="reset" aria-label="Fit plan">⤢</button>
        </div>

        <details class="vm-knobs" id="vm-knobs">
          <summary>Design</summary>
          <div class="vm-knobs-body">
            <fieldset>
              <legend>Palette</legend>
              <div class="vm-presets">
                {Object.entries(palettes).map(([key, p]) => (
                  <button type="button" data-preset={key} aria-pressed="false">
                    <span class="vm-swatches">
                      <i style={`background:${p.ink}`} /><i style={`background:${p.wall}`} /><i style={`background:${p.furniture}`} />
                    </span>
                    {p.label}
                  </button>
                ))}
              </div>
            </fieldset>
            <fieldset class="vm-colors">
              <legend>Colours</legend>
              {colorKnobs.map(([key, label]) => (
                <label><input type="color" data-color={key} />{label}</label>
              ))}
            </fieldset>
            <fieldset>
              <legend>Walls</legend>
              <div class="vm-seg" data-seg="walls">
                <button type="button" data-value="hatched">Hatched</button>
                <button type="button" data-value="solid">Solid</button>
                <button type="button" data-value="outline">Outline</button>
              </div>
            </fieldset>
            <fieldset>
              <legend>Markers</legend>
              <div class="vm-seg" data-seg="markers">
                <button type="button" data-value="uniform">Uniform</button>
                <button type="button" data-value="sections">By section</button>
              </div>
              <label class="vm-range">Size <input type="range" min="0.6" max="1.8" step="0.05" value="1" data-knob="size" /></label>
            </fieldset>
            <label class="vm-check"><input type="checkbox" data-knob="grid" checked /> Blueprint grid</label>
            <button type="button" class="vm-resetdesign" data-knob="reset">Reset design</button>
          </div>
        </details>
      </section>

      <section class="vm-legend" aria-label="Legend">
        {sections.map((s) => (
          <article class:list={["vm-card", { "vm-card-wide": s.items.length === 0 }]} data-section={s.id} style={`--sec: ${s.color}`}>
            <h2 tabindex={s.items.length ? 0 : undefined}>{s.items.length === 0 && <span aria-hidden="true">+ </span>}{s.title}</h2>
            <p class="vm-tagline">{s.tagline}</p>
            {s.notes && <p class="vm-notes">{s.notes.map((n) => <span>+ {n}</span>)}</p>}
            {s.items.length > 0 && (
              <ul>
                {s.items.map((i) => (
                  <li data-n={i.n} tabindex="0">
                    <span class="vm-badge">{i.n}</span>
                    <span>{i.label}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </section>
    </main>

    <script type="application/json" id="vm-palettes" set:html={JSON.stringify(palettes)} />

    <script>
      type Palette = Record<string, string>;
      type Design = { preset: string; colors: Palette; walls: string; markers: string; size: number; grid: boolean };

      const root = document.body;
      const svg = document.getElementById("vm-svg") as unknown as SVGSVGElement;
      const tip = document.getElementById("vm-tip") as HTMLDivElement;
      const palettes = JSON.parse(document.getElementById("vm-palettes")!.textContent!) as Record<string, Palette & { label: string }>;
      const STORAGE_KEY = "alps-venue-map-design";

      /* ---------- design knobs ---------- */

      const defaults = (): Design => {
        const { label: _label, ...colors } = palettes.blueprint;
        return { preset: "blueprint", colors, walls: "hatched", markers: "uniform", size: 1, grid: true };
      };

      let design: Design = defaults();
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed?.colors?.paper) design = { ...design, ...parsed };
        }
      } catch {}

      const colorInputs = [...document.querySelectorAll<HTMLInputElement>("[data-color]")];
      const presetButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-preset]")];
      const sizeInput = document.querySelector<HTMLInputElement>('[data-knob="size"]')!;
      const gridInput = document.querySelector<HTMLInputElement>('[data-knob="grid"]')!;

      const luminance = (hex: string) => {
        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
      };

      function applyDesign() {
        const c = design.colors;
        for (const [k, v] of Object.entries(c)) root.style.setProperty(`--vm-${k}`, v);
        // Legend badges sit on the navy page, so fall back to white for dark marker colours.
        root.style.setProperty("--vm-badge", luminance(c.marker) > 0.35 ? c.marker : "#ffffff");
        root.dataset.walls = design.walls;
        root.dataset.markers = design.markers;
        root.dataset.grid = design.grid ? "on" : "off";
        colorInputs.forEach((i) => (i.value = design.colors[i.dataset.color!]));
        presetButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.preset === design.preset)));
        document.querySelectorAll<HTMLElement>("[data-seg]").forEach((seg) => {
          const current = design[seg.dataset.seg as "walls" | "markers"];
          seg.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.value === current)));
        });
        sizeInput.value = String(design.size);
        gridInput.checked = design.grid;
        scaleMarkers();
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(design));
        } catch {}
      }

      presetButtons.forEach((b) =>
        b.addEventListener("click", () => {
          const { label: _label, ...colors } = palettes[b.dataset.preset!];
          design = { ...design, preset: b.dataset.preset!, colors };
          applyDesign();
        }),
      );
      colorInputs.forEach((i) =>
        i.addEventListener("input", () => {
          design = { ...design, preset: "custom", colors: { ...design.colors, [i.dataset.color!]: i.value } };
          applyDesign();
        }),
      );
      document.querySelectorAll<HTMLElement>("[data-seg]").forEach((seg) =>
        seg.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("button");
          if (!b) return;
          design = { ...design, [seg.dataset.seg!]: b.dataset.value };
          applyDesign();
        }),
      );
      sizeInput.addEventListener("input", () => {
        design = { ...design, size: Number(sizeInput.value) };
        applyDesign();
      });
      gridInput.addEventListener("change", () => {
        design = { ...design, grid: gridInput.checked };
        applyDesign();
      });
      document.querySelector('[data-knob="reset"]')!.addEventListener("click", () => {
        design = defaults();
        applyDesign();
      });

      /* ---------- pan & zoom (viewBox based) ---------- */

      const [bx, by, bw, bh] = svg.dataset.base!.split(" ").map(Number);
      const vb = { x: bx, y: by, w: bw, h: bh };
      const MAX_ZOOM = 14;
      let anim = 0;

      function clamp(v: typeof vb) {
        const w = Math.min(bw, Math.max(bw / MAX_ZOOM, v.w));
        const h = (w * bh) / bw;
        const cx = Math.min(bx + bw, Math.max(bx, v.x + v.w / 2));
        const cy = Math.min(by + bh, Math.max(by, v.y + v.h / 2));
        return { x: cx - w / 2, y: cy - h / 2, w, h };
      }

      function setView(v: typeof vb) {
        Object.assign(vb, clamp(v));
        svg.setAttribute("viewBox", `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
        scaleMarkers();
        if (pinned) placeTip(pinned);
      }

      function animateTo(target: typeof vb) {
        cancelAnimationFrame(anim);
        const from = { ...vb };
        const to = clamp(target);
        const t0 = performance.now();
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const step = (t: number) => {
          const k = reduce ? 1 : Math.min(1, (t - t0) / 380);
          const e = 1 - Math.pow(1 - k, 3);
          setView({
            x: from.x + (to.x - from.x) * e,
            y: from.y + (to.y - from.y) * e,
            w: from.w + (to.w - from.w) * e,
            h: from.h + (to.h - from.h) * e,
          });
          if (k < 1) anim = requestAnimationFrame(step);
        };
        anim = requestAnimationFrame(step);
      }

      function toUser(clientX: number, clientY: number) {
        const p = new DOMPoint(clientX, clientY).matrixTransform(svg.getScreenCTM()!.inverse());
        return { x: p.x, y: p.y };
      }

      function zoomAt(factor: number, p: { x: number; y: number }, animate = false) {
        const next = {
          x: p.x - (p.x - vb.x) / factor,
          y: p.y - (p.y - vb.y) / factor,
          w: vb.w / factor,
          h: vb.h / factor,
        };
        animate ? animateTo(next) : setView(next);
      }

      const centre = () => ({ x: vb.x + vb.w / 2, y: vb.y + vb.h / 2 });

      svg.addEventListener(
        "wheel",
        (e) => {
          e.preventDefault();
          cancelAnimationFrame(anim);
          const delta = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY;
          zoomAt(Math.exp(-delta * (e.ctrlKey ? 0.01 : 0.0022)), toUser(e.clientX, e.clientY));
        },
        { passive: false },
      );

      const pointers = new Map<number, { x: number; y: number }>();
      let pinchDist = 0;
      let moved = 0;

      svg.addEventListener("pointerdown", (e) => {
        cancelAnimationFrame(anim);
        svg.setPointerCapture(e.pointerId);
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        moved = 0;
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
        }
      });

      svg.addEventListener("pointermove", (e) => {
        const prev = pointers.get(e.pointerId);
        if (!prev) return;
        const scale = svg.getScreenCTM()!.a;
        if (pointers.size === 1) {
          const dx = e.clientX - prev.x;
          const dy = e.clientY - prev.y;
          moved += Math.abs(dx) + Math.abs(dy);
          if (moved > 4) svg.classList.add("is-dragging");
          setView({ ...vb, x: vb.x - dx / scale, y: vb.y - dy / scale });
        }
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          moved += 10;
          if (pinchDist) zoomAt(dist / pinchDist, toUser((a.x + b.x) / 2, (a.y + b.y) / 2));
          pinchDist = dist;
        }
      });

      const endPointer = (e: PointerEvent) => {
        pointers.delete(e.pointerId);
        pinchDist = 0;
        if (!pointers.size) svg.classList.remove("is-dragging");
      };
      svg.addEventListener("pointerup", endPointer);
      svg.addEventListener("pointercancel", endPointer);

      svg.addEventListener("dblclick", (e) => {
        if ((e.target as Element).closest(".vm-marker")) return;
        zoomAt(e.shiftKey ? 1 / 2 : 2, toUser(e.clientX, e.clientY), true);
      });

      document.querySelector(".vm-zoom")!.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest("button");
        if (!b) return;
        if (b.dataset.zoom === "in") zoomAt(1.6, centre(), true);
        if (b.dataset.zoom === "out") zoomAt(1 / 1.6, centre(), true);
        if (b.dataset.zoom === "reset") animateTo({ x: bx, y: by, w: bw, h: bh });
      });

      // Markers are sized in screen pixels (growing a little as you zoom in),
      // so they stay readable on a phone and don't balloon on a big screen.
      const markerScales = [...svg.querySelectorAll<SVGGElement>(".vm-marker-scale")];
      function scaleMarkers() {
        const ppu = svg.getScreenCTM()?.a || 1;
        const radiusPx = 12 * design.size * Math.min(1.5, Math.max(0.55, Math.pow(ppu / 1.3, 0.35)));
        const s = (radiusPx / (10.5 * ppu)).toFixed(4);
        markerScales.forEach((g) => g.setAttribute("transform", `scale(${s})`));
      }

      /* ---------- marker ⇄ legend highlighting ---------- */

      const markerEls = [...svg.querySelectorAll<SVGGElement>(".vm-marker")];
      const itemEls = [...document.querySelectorAll<HTMLLIElement>(".vm-legend li[data-n]")];
      const cardEls = [...document.querySelectorAll<HTMLElement>(".vm-card")];
      let pinned: SVGGElement | null = null;

      function highlight(ns: string[] | null) {
        const set = new Set(ns ?? []);
        markerEls.forEach((m) => m.classList.toggle("is-hot", set.has(m.dataset.n!)));
        itemEls.forEach((li) => li.classList.toggle("is-hot", set.has(li.dataset.n!)));
        cardEls.forEach((c) => c.classList.toggle("has-hot", !!c.querySelector("li.is-hot")));
        root.classList.toggle("has-hot", set.size > 0);
      }

      function placeTip(m: SVGGElement) {
        const li = itemEls.find((l) => l.dataset.n === m.dataset.n);
        const card = li?.closest(".vm-card");
        tip.innerHTML = `<b>${m.dataset.n}</b> ${li?.lastElementChild?.textContent ?? ""}<small>${card?.querySelector("h2")?.textContent ?? ""}</small>`;
        const r = m.getBoundingClientRect();
        const host = svg.getBoundingClientRect();
        tip.hidden = false;
        tip.style.left = `${r.left + r.width / 2 - host.left}px`;
        tip.style.top = `${r.top - host.top}px`;
      }

      const restore = () => {
        if (pinned) {
          highlight([pinned.dataset.n!]);
          placeTip(pinned);
        } else {
          highlight(null);
          tip.hidden = true;
        }
      };

      markerEls.forEach((m) => {
        m.addEventListener("pointerenter", (e) => {
          if (e.pointerType === "touch") return;
          highlight([m.dataset.n!]);
          placeTip(m);
        });
        m.addEventListener("pointerleave", restore);
        m.addEventListener("focus", () => {
          highlight([m.dataset.n!]);
          placeTip(m);
        });
        m.addEventListener("blur", restore);
        m.addEventListener("click", () => {
          if (moved > 4) return;
          pinned = pinned === m ? null : m;
          restore();
          if (pinned) itemEls.find((l) => l.dataset.n === m.dataset.n)?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        });
        m.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            m.dispatchEvent(new MouseEvent("click"));
          }
        });
      });

      // Clicking empty plan clears a pinned marker.
      svg.addEventListener("click", (e) => {
        if (moved > 4 || (e.target as Element).closest(".vm-marker")) return;
        pinned = null;
        restore();
      });

      function focusMarkers(ns: string[]) {
        const pts = markerEls.filter((m) => ns.includes(m.dataset.n!)).map((m) => m.transform.baseVal.consolidate()!.matrix);
        if (!pts.length) return;
        const xs = pts.map((p) => p.e);
        const ys = pts.map((p) => p.f);
        const pad = 70;
        const minX = Math.min(...xs) - pad, maxX = Math.max(...xs) + pad;
        const minY = Math.min(...ys) - pad, maxY = Math.max(...ys) + pad;
        const w = Math.max(maxX - minX, ((maxY - minY) * bw) / bh);
        const h = (w * bh) / bw;
        animateTo({ x: (minX + maxX) / 2 - w / 2, y: (minY + maxY) / 2 - h / 2, w, h });
        svg.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }

      itemEls.forEach((li) => {
        const on = () => highlight([li.dataset.n!]);
        li.addEventListener("pointerenter", on);
        li.addEventListener("focus", on);
        li.addEventListener("pointerleave", restore);
        li.addEventListener("blur", restore);
        li.addEventListener("click", () => focusMarkers([li.dataset.n!]));
        li.addEventListener("keydown", (e) => e.key === "Enter" && focusMarkers([li.dataset.n!]));
      });

      cardEls.forEach((card) => {
        const h2 = card.querySelector("h2");
        const ns = [...card.querySelectorAll<HTMLLIElement>("li[data-n]")].map((l) => l.dataset.n!);
        if (!h2 || !ns.length) return;
        const on = () => highlight(ns);
        h2.addEventListener("pointerenter", on);
        h2.addEventListener("focus", on);
        h2.addEventListener("pointerleave", restore);
        h2.addEventListener("blur", restore);
        h2.addEventListener("click", () => focusMarkers(ns));
        h2.addEventListener("keydown", (e) => e.key === "Enter" && focusMarkers(ns));
      });

      window.addEventListener("resize", () => {
        scaleMarkers();
        if (pinned) placeTip(pinned);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          pinned = null;
          restore();
          (document.getElementById("vm-knobs") as HTMLDetailsElement).open = false;
        }
      });

      applyDesign();
    </script>
  </body>
</html>

<style is:global>
