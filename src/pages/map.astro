---
import "../styles/app.css";
import VenuePlan from "../components/VenuePlan";
import { withBase } from "../lib/withBase";

const switzerFont = withBase("fonts/Switzer-Variable.woff2");
const fontFaceCss = `@font-face {
  font-family: "Switzer";
  src: url("${switzerFont}") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Working layout plan: not in the sitemap. -->
    <meta name="robots" content="noindex" />
    <title>Venue map | ALPS Conference 2026</title>
    <meta name="description" content="Layout plan of the Kultur & Kongresshaus Aarau for ALPS Conference 2026." />
    <meta name="theme-color" content="#0B3C5D" />
    <link rel="preload" href={switzerFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("img/venue-plan.svg")} as="fetch" type="image/svg+xml" crossorigin />
    <link rel="icon" type="image/png" href={withBase("img/favicon.png")} />
    <style is:global set:html={fontFaceCss}></style>
  </head>
  <body>
    <header class="map-head">
      <div>
        <p class="section-eyebrow">ALPS Conference 2026 · 9–10 October</p>
        <h1 class="section-title">Venue map</h1>
        <p class="map-sub">Kultur &amp; Kongresshaus Aarau: layout plan</p>
      </div>
      <p class="map-hint">Scroll or pinch to zoom · drag to pan · click a number</p>
    </header>
    <main class="map-main">
      <VenuePlan client:load size="page" legend designControls />
    </main>
  </body>
</html>

<style>
  .map-head,
  .map-main {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: clamp(16px, 3vw, 40px);
  }

  .map-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-top: clamp(28px, 5vw, 64px);
    padding-bottom: clamp(20px, 3vw, 32px);
  }

  .map-main {
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  .map-sub {
    margin: 0.75rem 0 0;
    color: rgba(238, 244, 248, 0.68);
    font-size: 1rem;
  }

  .map-hint {
    margin: 0;
    color: rgba(238, 244, 248, 0.68);
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    text-align: right;
  }

  @media (max-width: 640px) {
    .map-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .map-hint {
      text-align: left;
    }
  }
</style>
