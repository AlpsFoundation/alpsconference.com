---
import "../styles/app.css";
import VenuePlan from "../components/VenuePlan";
import { withBase } from "../lib/withBase";

const switzerFont = withBase("fonts/Switzer-Variable.woff2");
const ogImagePath = withBase("og/map.jpg");
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).href : ogImagePath;
const fontFaceCss = `@font-face {
  font-family: "Switzer";
  src: url("${switzerFont}") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Working layout plan: not in the sitemap. -->
    <meta name="robots" content="noindex" />
    <title>Venue map | ALPS Conference 2026</title>
    <meta name="description" content="Layout plan of the Kultur & Kongresshaus Aarau for ALPS Conference 2026." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Venue Map — ALPS Conference 2026" />
    <meta property="og:description" content="Layout plan of the Kultur & Kongresshaus Aarau." />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0B3C5D" />
    <link rel="preload" href={switzerFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("img/venue-plan.svg")} as="fetch" type="image/svg+xml" crossorigin />
    <link rel="icon" type="image/png" href={withBase("img/favicon.png")} />
    <style is:global set:html={fontFaceCss}></style>
  </head>
  <body>
    <header class="map-head">
      <h1>
        <a href={withBase("/")}>
          <img src={withBase("img/logo.png")} alt="ALPS Research Conference" width="753" height="306" />
        </a>
        <span class="sr-only">Venue map</span>
      </h1>
    </header>
    <main class="map-main">
      <VenuePlan client:load size="page" legend designControls />
    </main>
  </body>
</html>

<style>
  .map-head,
  .map-main {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: clamp(16px, 3vw, 40px);
  }

  .map-head {
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(18px, 2.5vw, 28px);
  }

  .map-head h1 {
    margin: 0;
  }

  .map-head a {
    display: inline-block;
  }

  .map-head img {
    display: block;
    width: auto;
    height: clamp(44px, 6vw, 64px);
  }

  .map-main {
    padding-bottom: clamp(48px, 6vw, 88px);
  }
</style>
