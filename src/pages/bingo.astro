---
import "../styles/app.css";
import BingoPage from "../components/BingoPage";
import { withBase } from "../lib/withBase";

const switzerFont = withBase("fonts/Switzer-Variable.woff2");
const switzerItalicFont = withBase("fonts/Switzer-VariableItalic.woff2");
const ogImagePath = withBase("og/bingo.jpg");
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).href : ogImagePath;

const fontFaceCss = `@font-face {
  font-family: "Switzer";
  src: url("${switzerFont}") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}
@font-face {
  font-family: "Switzer-Italic";
  src: url("${switzerItalicFont}") format("woff2");
  font-style: italic;
  font-weight: 100 900;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- No zoom on phones when tapping squares or focusing a field. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <!-- Unlisted: not linked, not in the sitemap. -->
    <meta name="robots" content="noindex" />
    <title>Conference bingo | ALPS Conference 2026</title>
    <meta
      name="description"
      content="A bingo card for ALPS Conference 2026, built from our members' experiences. Your sightings stay on your device."
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="ALPS Conference 2026 — bingo" />
    <meta property="og:description" content="A bingo card built from our members' experiences." />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0B3C5D" />
    <link rel="preload" href={switzerFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={withBase("img/favicon.png")} />
    <style is:global set:html={fontFaceCss}></style>
  </head>
  <body>
    <BingoPage client:load />
  </body>
</html>
