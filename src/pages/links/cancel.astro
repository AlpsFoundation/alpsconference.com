---
import "../../styles/app.css";
import CancelBookingPage from "../../components/CancelBookingPage";
import { withBase } from "../../lib/withBase";

const switzerFont = withBase("fonts/Switzer-Variable.woff2");
const ogImagePath = withBase("img/opengraph.jpg");
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).href : ogImagePath;

const fontFaceCss = `@font-face {
  font-family: "Switzer";
  src: url("${switzerFont}") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Cancel booking | ALPS Conference 2026</title>
    <meta name="description" content="Cancel an ALPS Conference 2026 experience booking." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Cancel booking · ALPS Conference 2026" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0B3C5D" />
    <link rel="preload" href={switzerFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={withBase("img/favicon.png")} />
    <style is:global set:html={fontFaceCss}></style>
  </head>
  <body>
    <CancelBookingPage client:load />
  </body>
</html>
