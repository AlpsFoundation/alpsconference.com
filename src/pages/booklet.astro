---
import "../styles/booklet.css";
import Booklet from "../components/booklet/Booklet.astro";
import { BOOKLET_NAV } from "../data/bookletContent";
import { withBase } from "../lib/withBase";

const switzerFont = withBase("fonts/Switzer-Variable.woff2");
const switzerItalic = withBase("fonts/Switzer-VariableItalic.woff2");
const ogImagePath = withBase("og/booklet.jpg");
// The printable booklet, in the shared Google Drive folder.
const PDF_URL = "https://drive.google.com/file/d/1LCfygDUhsKqnsl5no_FS9RBGc7M6RLfX/view?usp=sharing";
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).href : ogImagePath;

const fontFaceCss = `@font-face {
  font-family: "Switzer";
  src: url("${switzerFont}") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}
@font-face {
  font-family: "Switzer";
  src: url("${switzerItalic}") format("woff2");
  font-style: italic;
  font-weight: 100 900;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="en" data-toc="closed">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Conference booklet | ALPS Conference 2026</title>
    <meta name="description" content="Conference booklet for ALPS 2026, 9–10 October in Aarau, Switzerland: program, speakers, experiences, venue map and partners." />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ALPS 2026 conference booklet" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#123e67" />
    <link rel="preload" href={switzerFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={withBase("img/favicon.png")} />
    <style is:global set:html={fontFaceCss}></style>
    <script is:inline>
      // Scroll reveals only run when motion is welcome; without this class everything is simply visible.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        document.documentElement.classList.add("bk-motion");
      }
    </script>
  </head>
  <body>
    <a class="bk-skip" href="#index">Skip to contents</a>
    <header class="bk-chrome">
      <a class="bk-chrome__home" href="#top" aria-label="Back to the cover">
        <img src={withBase("img/booklet/alps-mark.png")} alt="" width="26" height="22" />
        <span>Booklet</span>
      </a>
      <p class="bk-chrome__section" aria-live="polite"><span id="bk-current">ALPS 2026</span></p>
      <div class="bk-chrome__actions">
        <a
          class="bk-chrome__pdf"
          href={PDF_URL}
          target="_blank"
          rel="noopener"
          aria-label="PDF version (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M12 18v-6" /><path d="m9 15 3 3 3-3" /></svg>
          <span class="bk-chrome__pdf-label">PDF</span>
        </a>
        <button type="button" class="bk-chrome__menu" aria-expanded="false" aria-controls="bk-toc">
          <span class="bk-chrome__menu-label">Contents</span>
          <span class="bk-chrome__menu-icon" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </header>

    <div class="bk-toc__backdrop" hidden></div>
    <nav class="bk-toc" id="bk-toc" aria-label="Contents" hidden>
      <p class="bk-toc__kicker">ALPS 2026 · Conference booklet</p>
      <ol>
        {BOOKLET_NAV.map((item) => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    <main class="booklet">
      <Booklet />
    </main>

    <script>
      const root = document.documentElement;
      const pages = [...document.querySelectorAll<HTMLElement>(".bk-page")];

      /* ------------------------------------------------ scroll reveals -- */
      if (root.classList.contains("bk-motion")) {
        // Each page's direct content blocks rise in one after another; lists and grids stagger their items.
        const STAGGER = ".bk-schedule > li, .bk-team > li, .bk-partners li, .bk-poster-grid > li, .bk-tracks > *, .bk-events > *, .bk-panel > li, .bk-tiers > li, .bk-index > li";
        for (const page of pages) {
          const body = page.querySelector(".bk-body");
          if (!body) continue;
          page.querySelectorAll<HTMLElement>(STAGGER).forEach((item, index) => {
            item.dataset.reveal = "item";
            item.style.setProperty("--i", String(index % 12));
          });
          // Blocks fade in as a whole, unless they hold staggered items: then their other children do.
          let order = 0;
          const mark = (block: HTMLElement) => {
            if (block.dataset.reveal) return;
            if (block.querySelector("[data-reveal='item']")) {
              for (const child of block.children) mark(child as HTMLElement);
              return;
            }
            block.dataset.reveal = "";
            block.style.setProperty("--i", String(Math.min(order++, 6)));
          };
          for (const block of body.children) mark(block as HTMLElement);
        }

        const revealer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              revealer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
        );
        document.querySelectorAll("[data-reveal], .bk-art").forEach((el) => revealer.observe(el));
      }

      /* --------------------------------------------- current section -- */
      const current = document.getElementById("bk-current");
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".bk-toc a")];
      const firstPageOf = new Map<string, string>();
      for (const link of tocLinks) {
        const page = document.querySelector<HTMLElement>(link.hash);
        if (page?.dataset.section) firstPageOf.set(page.dataset.section, link.hash);
      }
      let active: HTMLElement | null = null;
      const visible = new Map<Element, number>();
      const tracker = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) visible.set(entry.target, entry.isIntersecting ? entry.intersectionRatio : 0);
          // The page covering the band under the header wins.
          let best: HTMLElement | null = null;
          let bestRatio = 0;
          for (const [el, ratio] of visible) {
            if (ratio > bestRatio) {
              best = el as HTMLElement;
              bestRatio = ratio;
            }
          }
          if (!best || best === active) return;
          active = best;
          const section = best.dataset.section ?? "ALPS 2026";
          if (current && current.textContent !== section) current.textContent = section;
          const hash = firstPageOf.get(section);
          for (const link of tocLinks) {
            const isCurrent = link.hash === hash;
            link.classList.toggle("is-current", isCurrent);
            if (isCurrent) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          }
        },
        { rootMargin: "-64px 0px -55% 0px", threshold: [0, 0.01, 0.1, 0.25, 0.5, 0.75, 1] }
      );
      pages.forEach((page) => tracker.observe(page));

      /* ----------------------------------------------------- contents -- */
      const menu = document.querySelector<HTMLButtonElement>(".bk-chrome__menu");
      const toc = document.getElementById("bk-toc");
      const backdrop = document.querySelector<HTMLElement>(".bk-toc__backdrop");

      function setTocOpen(open: boolean) {
        root.dataset.toc = open ? "open" : "closed";
        menu?.setAttribute("aria-expanded", String(open));
        toc?.toggleAttribute("hidden", !open);
        backdrop?.toggleAttribute("hidden", !open);
        if (open) toc?.querySelector<HTMLAnchorElement>("a.is-current, a")?.focus({ preventScroll: true });
      }

      menu?.addEventListener("click", () => setTocOpen(root.dataset.toc !== "open"));
      backdrop?.addEventListener("click", () => setTocOpen(false));
      tocLinks.forEach((link) => link.addEventListener("click", () => setTocOpen(false)));
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && root.dataset.toc === "open") {
          setTocOpen(false);
          menu?.focus();
        }
      });
    </script>
  </body>
</html>
