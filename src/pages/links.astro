---
import "../styles/app.css";
import LinksPage from "../components/LinksPage";
import { withBase } from "../lib/withBase";

const switzerFont = withBase("fonts/Switzer-Variable.woff2");
const ogImagePath = withBase("img/opengraph.jpg");
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).href : ogImagePath;

const fontFaceCss = `@font-face {
  font-family: "Switzer";
  src: url("${switzerFont}") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Unlisted until launch: not linked, not in the sitemap. -->
    <meta name="robots" content="noindex" />
    <title>Links | ALPS Conference 2026</title>
    <meta
      name="description"
      content="Quick access for ALPS Conference 2026 attendees: what is on now, the program, venue map, wifi and experience sign-ups."
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ALPS Conference 2026 — attendee links" />
    <meta
      property="og:description"
      content="What is on now, the program, venue map, wifi and experience sign-ups."
    />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Theme -->
    <meta name="theme-color" content="#0B3C5D" />

    <!-- Fonts -->
    <link rel="preload" href={switzerFont} as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={withBase("img/favicon.png")} />

    <style is:global set:html={fontFaceCss}></style>
  </head>
  <body>
    <LinksPage client:load />
  </body>
</html>
